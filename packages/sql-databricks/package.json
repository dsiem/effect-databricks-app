{
  "name": "effect-sql-databricks",
  "version": "0.1.0",
  "description": "Databricks SQL warehouse adapter for Effect 4 with Apache Arrow results",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke:live": "node --env-file-if-exists=../../.env scripts/live.mjs",
    "presmoke:live": "npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "effect": "~4.1.4"
  },
  "dependencies": {
    "apache-arrow": "21.2.0"
  }
}
