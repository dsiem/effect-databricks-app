{
  "name": "databricks-effect-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19 <23"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present && tsc -p tsconfig.build.json && vite build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "npm run build --workspaces --if-present && npm run typecheck --workspaces --if-present && tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run test --workspaces --if-present && node --import tsx --test test/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke && npm run package:check",
    "package:check": "node scripts/check-package.mjs",
    "bundle:check": "node scripts/check-bundle.mjs",
    "bundle:validate": "databricks bundle validate --strict",
    "deploy:dev": "databricks bundle deploy -t dev && databricks bundle run app -t dev",
    "dev:server": "npm run build --workspaces --if-present && node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "dev:client": "vite --host 127.0.0.1",
    "test:e2e": "playwright test",
    "data:check": "node --env-file-if-exists=.env --import tsx scripts/check-live.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "@effect/sql-pg": "4.1.4",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.107.1",
    "@types/node": "22.20.5",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "4.1.4",
    "effect-sql-databricks": "0.1.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.65.0",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "tsx": "4.23.15",
    "yaml": "2.9.1"
  }
}
