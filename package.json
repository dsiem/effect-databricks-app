{
  "name": "databricks-effect-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19 <23"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke",
    "bundle:check": "node scripts/check-bundle.mjs",
    "bundle:validate": "databricks bundle validate --strict",
    "deploy:dev": "databricks bundle deploy -t dev && databricks bundle run app -t dev"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "@types/node": "22.20.5",
    "effect": "4.1.4",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "ajv": "8.20.0",
    "tsx": "4.23.15",
    "yaml": "2.9.1"
  }
}
