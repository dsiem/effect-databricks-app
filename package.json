{
  "name": "databricks-effect-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.5 <23"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present && tsc -p tsconfig.build.json && vite build",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "typecheck": "npm run build --workspaces --if-present && npm run typecheck --workspaces --if-present && tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run test --workspaces --if-present && node --import tsx --test test/*.test.ts client/test/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run docs:check && npm run architecture:check && npm run client:check && npm run lint && npm run typecheck && npm test && npm run build && npm run smoke && npm run package:check",
    "docs:check": "node scripts/check-docs.mjs",
    "package:check": "node scripts/check-package.mjs",
    "bundle:check": "node scripts/check-bundle.mjs",
    "bundle:validate": "databricks bundle validate --strict",
    "deploy:dev": "npm run workspace:setup -- dev",
    "dev:server": "npm run build --workspaces --if-present && node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "dev:client": "vite --host 127.0.0.1",
    "test:e2e": "playwright test",
    "data:check": "node --env-file-if-exists=.env --import tsx scripts/check-live.ts",
    "data:check:comments": "node --env-file-if-exists=.env --import tsx scripts/check-trip-comments.ts",
    "data:seed:snapshot": "databricks bundle run seed_trip_snapshot",
    "data:prepare": "node --env-file-if-exists=.env scripts/prepare-taxi-data.mjs",
    "data:boundaries": "node scripts/prepare-zcta.mjs",
    "maps:compare": "node --env-file-if-exists=.env scripts/compare-maps.mjs",
    "data:check:gps": "node --env-file-if-exists=.env --import tsx scripts/check-gps.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "workspace:setup": "node scripts/setup-workspace.mjs",
    "test:filters": "playwright test --config playwright.filters.config.ts --workers=2",
    "test:ui": "playwright test --config playwright.architecture.config.ts design.spec.ts --workers=1",
    "test:browser": "playwright test --config playwright.architecture.config.ts",
    "test:architecture": "npm test && npm run build && npm run test:browser",
    "client:check": "node scripts/check-client.mjs",
    "architecture:check": "node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.1",
    "@deck.gl/layers": "9.4.1",
    "@deck.gl/maplibre": "9.4.1",
    "@effect/platform-browser": "4.1.4",
    "@effect/platform-node": "4.1.4",
    "@effect/sql-pg": "4.1.4",
    "@foldkit/ui": "0.170.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "date-fns": "4.4.0",
    "effect": "4.1.4",
    "effect-sql-databricks": "0.1.0",
    "foldkit": "0.170.0",
    "maplibre-gl": "6.18.0",
    "marked": "17.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.0",
    "ajv": "8.20.0",
    "tsx": "4.23.15",
    "yaml": "2.9.1"
  }
}
