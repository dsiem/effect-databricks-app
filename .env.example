# Local ports. npm run dev serves the frontend at :5173 and the Effect API at :3000.
DATABRICKS_APP_PORT=3000
APP_HTTP_PROTOCOL=http1

# npm run workspace:setup fills these from the deployed bundle.
# Local authentication uses databricks auth login. No token needs to be copied.
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CONFIG_PROFILE=
GENIE_SPACE_ID=
LAKEBASE_ENDPOINT=
PGHOST=
PGDATABASE=databricks_postgres
PGUSER=

# Optional alternatives; keep credentials server-side and out of version control.
# DATABRICKS_TOKEN=
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
# PGPASSWORD=
