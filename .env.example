# Run databricks bundle run local_env -t dev to write the connection settings.
# The local API uses your Databricks CLI login.
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_ID=
# Fully qualified snapshot table in the form <data_catalog>.<data_schema>.trips_2016.
TRIP_SNAPSHOT_TABLE=
ANALYSIS_JOB_ID=
ANALYSIS_RESULTS_TABLE=
DATABRICKS_CONFIG_PROFILE=
GENIE_SPACE_ID=
LAKEBASE_ENDPOINT=
PGHOST=
PGDATABASE=databricks_postgres
PGUSER=

# Optional alternatives; keep credentials server-side and out of version control.
# DATABRICKS_TOKEN=
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
# PGPASSWORD=
